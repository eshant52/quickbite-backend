					"item": [
						{
							"name": "Login with Email & Password",
							"event": [
								{
									"listen": "test",
									"script": {
										"type": "text/javascript",
										"exec": [
											"const response = pm.response.json(); \npm.collectionVariables.set(\"challenge_token\", response.challengeToken); \npm.collectionVariables.set(\"access_token\", response.accessToken); \npm.collectionVariables.set(\"refresh_token\", response.refreshToken); \npm.collectionVariables.set(\"session_id\", response.sessionId);"
										]
